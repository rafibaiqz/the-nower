# ---------------------------------------------------------------------------
# THE NOWER — environment configuration (copy to .env; never commit secrets).
# ---------------------------------------------------------------------------

# --- Game server (server/) ---------------------------------------------------
# Port and interface the HTTP + WebSocket server listens on.
PORT=3001
HOST=0.0.0.0
# Comma-separated browser origins allowed to connect (CORS for Socket.IO).
# Use * only for local development. Example for a split deployment:
# CLIENT_ORIGIN=https://the-nower.netlify.app,https://nower.example.com
CLIENT_ORIGIN=*
# Players per lobby (default 4, hard cap 8).
MAX_PLAYERS=4
# Maximum number of simultaneous lobbies on this server.
MAX_LOBBIES=200
# Close lobbies idle in the waiting room for this many minutes.
LOBBY_IDLE_MINUTES=30
# Directory with the built web client to serve from the same origin (single-service
# deployment). Leave empty to run the server as a pure game API.
STATIC_DIR=
# debug | info | warn | error
LOG_LEVEL=info

# --- Web client (client/, read at BUILD time by Vite) --------------------------
# Public URL of the game server. Leave empty when the server also serves the client
# (same origin). In local development it defaults to http://<host>:3001.
# Must be https:// in production so the socket upgrades to secure WebSockets (wss://).
VITE_SERVER_URL=
# Network transport: empty = Socket.IO (Node server); "ws" = raw WebSocket for the Cloudflare
# Worker / Durable Object. `npm run build:cloudflare` sets it via client/.env.cloudflare.
VITE_TRANSPORT=
