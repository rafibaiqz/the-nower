{
  "name": "the-nower",
  "version": "1.0.0",
  "private": true,
  "description": "THE NOWER — 3D multiplayer survival horror. A game by Raff & Noer.",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w client",
    "test": "vitest run",
    "map": "tsx scripts/print-map.ts",
    "e2e": "node scripts/e2e.mjs",
    "photos": "node scripts/photos.mjs",
    "test:all": "npm run typecheck && npm test && npm run build && npm run e2e",
    "build:cloudflare": "npm run build -w client -- --mode cloudflare",
    "dev:cloudflare": "wrangler dev",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:cloudflare": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0",
    "wrangler": "4.155.0",
    "@cloudflare/workers-types": "^4.20260702.1"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
